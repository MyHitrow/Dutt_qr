# Dutt Meyhane - Örnek Çevre Değişkenleri Şablonu
# Bu dosyayı .env.local olarak kopyalayın ve gerçek değerleri girin.
ADMIN_SECRET_PATH=management-portal-secure
NEXT_PUBLIC_DEFAULT_VENUE_NAME="Dutt Meyhane"

# Yönetici Giriş Bilgileri (Tekil veya Çift Format)
ADMIN_USERNAMES=admin
ADMIN_PASSWORDS=guclu_parola_buraya
ADMIN_CREDENTIALS=admin:guclu_parola_buraya

# 256-bit Rastgele JWT İmzası
ADMIN_JWT_SECRET=ornek_jwt_gizli_anahtari_min_32_karakter
